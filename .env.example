# Model APIs for local development
# ANTHROPIC_API_KEY is used by the API (agent runs), `make smoke` and `make record`.
# Tests and CI never need it.
ANTHROPIC_API_KEY=your-api-key
OPENAI_API_KEY=your-api-key

# Backend
DATABASE_URL=postgresql+psycopg://agentops:agentops@localhost:5432/agentops
TEST_DATABASE_URL=postgresql+psycopg://agentops:agentops@localhost:5432/agentops_test
CORS_ORIGINS=["http://localhost:3000"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
